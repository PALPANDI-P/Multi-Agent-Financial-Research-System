# Base URL of the backend API.
#
# The default is the RELATIVE `/api/v1`: the browser then calls the Vite dev
# proxy (or the reverse proxy of the deployment) on its own origin, so the
# session cookie of the backend is sent with every request.
#
# This matters: the backend stores the session in the HttpOnly cookie
# `frs_session` with `SameSite=Lax`, and a `SameSite=Lax` cookie is NOT sent
# with a cross-origin request.  Use the proxy mode for the browser.
VITE_API_BASE_URL=/api/v1

# Absolute URL mode - for the API documentation and for curl:
# the backend then has to allow the origin of the frontend in CORS_ORIGINS.
# Note: the browser session cookie needs the proxy mode above.
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# Optional: the address the Vite dev proxy forwards `/api` to.
VITE_DEV_PROXY_TARGET=http://localhost:8000