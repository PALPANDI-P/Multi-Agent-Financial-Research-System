# Base URL of the backend API.
# Default (used when this variable is absent): http://localhost:8000/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Optional: point the browser at the Vite dev proxy instead of the backend
# directly, which removes the need for CORS during development.
# VITE_API_BASE_URL=/api/v1

# Optional: the address the Vite dev proxy forwards `/api` to.
# VITE_DEV_PROXY_TARGET=http://localhost:8000
