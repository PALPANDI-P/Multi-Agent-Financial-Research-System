# =============================================================================
# Multi-Agent Financial Research System - container stack configuration
# =============================================================================
# Copy this file to `.env` in the repository root and replace the placeholder:
#
#     copy .env.example .env
#
# `docker compose` reads this file automatically (the variables are used for
# the interpolation of the compose file and they are injected into the
# backend container through `env_file`).
#
# The file is ignored by git (see .gitignore), therefore the password never
# reaches the repository.
#
# NOTE: the compose stack was AUTHORED but NOT EXECUTED on the development
# machine - Docker is not installed there.  See README.md.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL credentials of the compose stack
# -----------------------------------------------------------------------------
# The password below is a PLACEHOLDER.  Replace it with a real password
# before you start the stack; the value must match the password of the
# `frs` role in the database.
POSTGRES_USER=frs
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=financial_research

# The host port the database is published on.  55432 is the port of the
# micromamba development cluster, so that the containerised database and the
# local development database do not collide.
POSTGRES_PORT=55432

# The host ports of the API and of the SPA.
BACKEND_PORT=8000
FRONTEND_PORT=8080

# -----------------------------------------------------------------------------
# Application settings of the backend container
# -----------------------------------------------------------------------------
# Every value below is optional: when it is not set, the backend falls back
# to its own default (backend/app/core/config.py).  The list valued settings
# are JSON arrays and must keep their double quotes.
#
# This file carries the variables of the CONTAINER STACK.  The COMPLETE list
# of the application settings - every setting of `backend/app/core/config.py`
# with its default - is in `backend/.env.example`; a setting that is not
# listed here keeps its default, or the value that the `environment:` block
# of `docker-compose.yml` sets for it (DATABASE_URL, STORAGE_ROOT and the
# seed paths are set there and are therefore NOT taken from this file).
APP_NAME="Multi-Agent Financial Research System"
APP_ENV="development"
APP_VERSION="0.1.0"
DEBUG=false
LOG_LEVEL="INFO"
LOG_FORMAT="json"

MAX_UPLOAD_SIZE_BYTES=52428800
MAX_PDF_PAGES=2000
MIN_TEXT_CHARS_PER_PAGE=40

EMBEDDING_PROVIDER="fastembed"
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3
EMBEDDING_TIMEOUT_SECONDS=60.0

CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
CHUNK_MIN_TOKENS=32
CHUNK_MAX_TOKENS=1024

RETRIEVAL_TOP_K=10
RETRIEVAL_MAX_TOP_K=100

PROCESSING_INLINE=false
TABLE_EXTRACTION_ENABLED=true
OCR_ENABLED=false
OCR_LANGUAGE="eng"

# The browser reaches the SPA on http://localhost:8080 (the published port of
# the frontend service).
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
ALLOWED_DOCUMENT_EXTENSIONS=[".pdf"]
ALLOWED_MIME_TYPES=["application/pdf"]

# The base URL of the API that the built SPA calls.  The relative path is
# served by the nginx reverse proxy of the frontend container.
VITE_API_BASE_URL="/api/v1"
