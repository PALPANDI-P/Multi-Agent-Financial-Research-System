from __future__ import annotations

from functools import lru_cache
from pathlib import Path
from typing import Literal

from pydantic_settings import BaseSettings, SettingsConfigDict

from app.core.exceptions import ConfigurationError

__all__ = [
    'BACKEND_DIR',
    'ENV_FILE',
    'Settings',
    'get_settings',
    'load_settings',
    'settings',
    'validate_runtime_settings',
]

BACKEND_DIR: Path = Path(__file__).resolve().parents[2]
ENV_FILE: Path = BACKEND_DIR / 'backend' / '.env'


class Settings(BaseSettings):
    '''Application settings.

    Every field has an environment variable counterpart with the same
    UPPER_SNAKE_CASE name (for example 'APP_NAME', 'DATABASE_URL') because
    'env_prefix' is empty.  List valued settings are parsed as JSON arrays.
    '''

    model_config = SettingsConfigDict(
        env_file=str(ENV_FILE),
        env_file_encoding='utf-8',
        case_sensitive=False,
        extra='ignore',
    )

    # ---- application metadata ---------------------------------------------------
    app_name: str = 'Multi-Agent Financial Research System'
    app_env: Literal['development', 'production'] = 'development'
    app_version: str = '0.1.0'
    debug: bool = False
    log_level: str = 'INFO'
    log_format: str = 'json'

    # ---- database ----------------------------------------------------------------
    database_url: str = 'postgresql+psycopg://frs:CHANGE_ME@127.0.0.1:55432/financial_research'
    database_pool_size: int = 5
    database_max_overflow: int = 10
    database_pool_timeout: int = 30
    database_echo: bool = False

    # ---- document storage -------------------------------------------------------
    storage_provider: str = 'local'
    storage_root: Path = Path('data/storage')
    max_upload_size_bytes: int = 52428800
    allowed_document_extensions: list[str] = ['.pdf']
    allowed_mime_types: list[str] = ['application/pdf']
    max_pdf_pages: int = 2000
    min_text_chars_per_page: int = 40

    # ---- embeddings -------------------------------------------------------------
    embedding_provider: str = 'fastembed'
    embedding_model: str = 'BAAI/bge-small-en-v1.5'
    embedding_dimension: int = 384
    embedding_batch_size: int = 32
    embedding_max_retries: int = 3
    embedding_timeout_seconds: float = 60.0

    # ---- chunking ---------------------------------------------------------------
    chunk_size_tokens: int = 512
    chunk_overlap_tokens: int = 64
    chunk_min_tokens: int = 32
    chunk_max_tokens: int = 1024

    # ---- retrieval ----------------------------------------------------------------
    retrieval_top_k: int = 10
    retrieval_max_top_k: int = 100

    # ---- processing pipeline -----------------------------------------------------
    processing_max_attempts: int = 3
    processing_inline: bool = False
    table_extraction_enabled: bool = True
    ocr_enabled: bool = False
    ocr_language: str = 'eng'

    # ---- http --------------------------------------------------------------------
    cors_origins: list[str] = ['http://localhost:5173', 'http://127.0.0.1:5173']

    # ---- seed corpus -------------------------------------------------------------
    seed_manifest_path: str = 'data/seed_manifest.json'
    seed_documents_dir: str = 'data/documents'


def load_settings() -> Settings:
    '''Resolve the settings and run runtime validation.

    The FastAPI application factory MUST call this during startup so that an
    invalid or unsafe configuration fails fast instead of at the first request.
    '''
    config = get_settings()
    validate_runtime_settings(config)
    return config


@lru_cache(maxsize=1)
def get_settings() -> Settings:
    '''Return a cached settings instance.

    The cache can be cleared with get_settings.cache_clear() (useful in
    tests).  The instance is built from the process environment and the
    ackend/.env file.  Only one instance is ever created and reused
    throughout the process lifetime.
    '''
    return Settings()


# Convenience accessor

def settings() -> Settings:
    '''Module level convenience accessor.

    This is a function and not a module level mutable object so that a
    reloaded configuration can never be silently ignored by an importing
    module.
    '''
    return get_settings()


def validate_runtime_settings(config: Settings) -> None:
    '''Raise :class:pp.core.exceptions.ConfigurationError when the configuration
    is self-contradictory or unsafe for the selected environment.

    Parameters
    ----------
    config
        The settings to validate.

    Raises
    ------
    ConfigurationError
        When the configuration is invalid or unsafe.
    '''
    if config.app_env == 'production':
        if config.debug:
            raise ConfigurationError(
                'DEBUG must not be true in production',
                details={'debug': True, 'app_env': 'production'},
            )

        if '*' in config.cors_origins:
            raise ConfigurationError(
                'CORS_ORIGINS must not contain '*' in production',
                details={'cors_origins': config.cors_origins, 'app_env': 'production'},
            )

        if 'CHANGE_ME' in config.database_url:
            raise ConfigurationError(
                'DATABASE_URL must not contain the development placeholder in production',
                details={'database_url': config.database_url, 'app_env': 'production'},
            )

