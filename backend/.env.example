# =============================================================================
# Multi-Agent Financial Research System - backend configuration template
# =============================================================================
# Copy this file to `backend/.env` and adjust the values for your machine:
#
#     copy backend\.env.example backend\.env
#
# Every variable below overrides the matching application setting.  The
# variable name is the UPPER_SNAKE_CASE form of the setting name because the
# settings use an empty environment prefix.
#
# List valued settings are parsed as JSON arrays - keep the double quotes:
#
#     CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
#
# -----------------------------------------------------------------------------
# Local PostgreSQL (micromamba)
# -----------------------------------------------------------------------------
# The development database is the micromamba managed PostgreSQL 16 cluster
# with pgvector that lives OUTSIDE the repository (E:\mamba\envs\frs, cluster
# E:\pgdata\frs, port 55432).  It is started and stopped with:
#
#     powershell -ExecutionPolicy Bypass -File scripts\db.ps1 -Action status|start|stop
#
# The development and test databases are:
#
#     dev  : postgresql+psycopg://frs:<password>@127.0.0.1:55432/financial_research
#     test : postgresql+psycopg://frs:<password>@127.0.0.1:55432/financial_research_test
#
# -----------------------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------------------
# EMBEDDING_DIMENSION must match the output dimension of EMBEDDING_MODEL.
#   BAAI/bge-small-en-v1.5 -> 384
# Changing the model means changing the dimension, the vector column and a
# new migration (the existing rows would have to be re-embedded).
#
# -----------------------------------------------------------------------------
# Production
# -----------------------------------------------------------------------------
# A production deployment MUST override at least DATABASE_URL and
# CORS_ORIGINS.  `validate_runtime_settings()` refuses to start when
# APP_ENV=production still uses the development database credentials, when
# DEBUG is true, or when CORS_ORIGINS contains "*".
# =============================================================================

# ---- application metadata ----------------------------------------------------
APP_NAME="Multi-Agent Financial Research System"
APP_ENV="development"
APP_VERSION="0.1.0"
DEBUG=false
LOG_LEVEL="INFO"
LOG_FORMAT="json"

# ---- database ---------------------------------------------------------------
DATABASE_URL="postgresql+psycopg://frs:CHANGE_ME@127.0.0.1:55432/financial_research"
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# ---- document storage -------------------------------------------------------
STORAGE_PROVIDER="local"
STORAGE_ROOT="data/storage"
MAX_UPLOAD_SIZE_BYTES=52428800
ALLOWED_DOCUMENT_EXTENSIONS=[".pdf"]
ALLOWED_MIME_TYPES=["application/pdf"]
MAX_PDF_PAGES=2000
MIN_TEXT_CHARS_PER_PAGE=40

# ---- embeddings -------------------------------------------------------------
EMBEDDING_PROVIDER="fastembed"
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3
EMBEDDING_TIMEOUT_SECONDS=60.0

# ---- chunking ---------------------------------------------------------------
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
CHUNK_MIN_TOKENS=32
CHUNK_MAX_TOKENS=1024

# ---- retrieval --------------------------------------------------------------
RETRIEVAL_TOP_K=10
RETRIEVAL_MAX_TOP_K=100

# ---- processing pipeline ----------------------------------------------------
PROCESSING_MAX_ATTEMPTS=3
# No background queue exists in M1: the pipeline runs inline.
PROCESSING_INLINE=true
TABLE_EXTRACTION_ENABLED=true
OCR_ENABLED=false
OCR_LANGUAGE="eng"

# ---- http -------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---- seed corpus ------------------------------------------------------------
SEED_MANIFEST_PATH="data/seed_manifest.json"
SEED_DOCUMENTS_DIR="data/documents"